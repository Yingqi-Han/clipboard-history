<UserControl x:Class="YingqiClipboard.ClipboardHistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Grid MaxWidth="880" Margin="0,0,0,36" HorizontalAlignment="Left">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Text="剪贴板历史" />
      <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="从 Win+V 增量导入文本和图片；工具关闭后停止同步，本地历史仍会保留。" />
      <ui:InfoBar x:Name="StatusBar" Grid.Row="2" Margin="0,18,0,0" IsOpen="True" Severity="Informational" Title="正在准备" Message="正在读取本地历史…" />
    </Grid>

    <ui:Card Grid.Row="1" Margin="0,20,0,16" Padding="18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" MinWidth="220" Height="40" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
            AutomationProperties.Name="搜索剪贴板历史" ToolTip="搜索文本历史" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
          <ui:Button Margin="0,0,8,0" Content="全部" Tag="All" Click="Filter_Click" />
          <ui:Button Margin="0,0,8,0" Content="文本" Tag="Text" Click="Filter_Click" />
          <ui:Button Content="图片" Tag="Image" Click="Filter_Click" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
          <ui:Button x:Name="OpenCompactButton" Margin="0,0,8,8" Appearance="Primary" Content="打开置顶小窗" Click="OpenCompact_Click" />
          <ui:Button Margin="0,0,8,8" Content="立即同步" Click="Refresh_Click" />
          <ui:Button Margin="0,0,8,8" Content="打开 Win+V 设置" Click="OpenSettings_Click" />
          <ui:Button Margin="0,0,8,8" Content="清空本地历史" Click="Clear_Click" />
          <TextBlock x:Name="UsageText" Margin="8,9,0,8" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </WrapPanel>
      </Grid>
    </ui:Card>

    <Grid Grid.Row="2">
      <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
          MouseDoubleClick="HistoryList_MouseDoubleClick">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ui:Card Padding="16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="92" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                <Border MaxHeight="180" Background="{DynamicResource ControlAltFillColorSecondaryBrush}" CornerRadius="8"
                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                  <Image Source="{Binding Thumbnail}" MaxHeight="180" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                  <ui:Button Margin="0,0,0,8" Content="复制" Tag="{Binding}" Click="Copy_Click" />
                  <ui:Button Content="删除" Tag="{Binding}" Click="Delete_Click" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                  <Run Text="{Binding DisplayTime, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DisplaySize, Mode=OneWay}"/>
                </TextBlock>
              </Grid>
            </ui:Card>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
        <ui:SymbolIcon Symbol="Clipboard24" FontSize="38" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Margin="0,12,0,0" Text="还没有可显示的历史" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Margin="0,6,0,0" Text="复制一些文字或截图，然后点击“立即同步”。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
